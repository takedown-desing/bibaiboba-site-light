---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, absUrl, withBase } from '../lib/site.mjs';
import { buildGraph } from '../lib/schema.mjs';
interface Props { d: any }
const { d } = Astro.props;
const graph = buildGraph(d);
const ogImage = absUrl('/og.png');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{d.title}</title>
    <meta name="description" content={d.description} />
    <link rel="canonical" href={absUrl(d.url)} />
    {SITE.preview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={d.type === 'case' ? 'article' : 'website'} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={d.og_title || d.title} />
    <meta property="og:description" content={d.og_description || d.description} />
    <meta property="og:url" content={absUrl(d.url)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#EFEFEF" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">К содержанию</a>
    <slot name="hero" />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
