---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeSections from '../components/HomeSections.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import AuthorBox from '../components/AuthorBox.astro';
import RollButton from '../components/RollButton.astro';
import LeadForm from '../components/LeadForm.astro';
import Badge from '../components/Badge.astro';
import images from '../data/images.json';
import { withBase, AUTHORS } from '../lib/site.mjs';
import { previewFor } from '../lib/previews.mjs';
import CaseCard from '../components/CaseCard.astro';
import CaseMosaic from '../components/CaseMosaic.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => {
    const url = entry.data.url;
    const slug = url === '/' ? undefined : url.replace(/^\/|\/$/g, '');
    return { params: { slug }, props: { entry } };
  });
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const img = (images as any)[d.slug] || {};
const own = previewFor(d.url);
const person = d.type === 'person' ? (d.url === AUTHORS.valentin.url ? AUTHORS.valentin : AUTHORS.aleksey) : null;
const heroImg = person ? { file: person.photo, alt: person.name, width: 800, height: 800, portrait: true } : own?.own ? own : img.hero;
const toc = headings.filter((h) => h.depth === 2);
const isForm = ['lead-form', 'form', 'contact'].includes(d.type);
const formKind = d.type === 'lead-form' ? 'audit' : d.type === 'form' ? 'brief' : 'contact';
const allCases = d.type === 'hub' ? (await getCollection('pages')).filter((p) => p.data.type === 'case').map((p) => p.data) : [];
const caseHighlights = d.type === 'case' && d.case ? [
  { value: d.case.contacts, label: 'обращений за месяц' },
  { value: d.case.contact_price, label: 'цена обращения' },
  { value: d.case.views, label: 'просмотров' },
  { value: d.case.spend, label: 'затраты на продвижение' },
] : null;
const hd = caseHighlights ? { ...d, highlights: d.highlights?.length ? d.highlights : caseHighlights } : d;
---
<Base d={d}>
  {d.type === 'home'
    ? <HomeHero slot="hero" d={d} />
    : <PageHero slot="hero" d={hd} image={heroImg} />}

  {d.type === 'home' ? (
    <HomeSections d={d}><Content /></HomeSections>
  ) : (<>
    {d.type === 'hub' && allCases.length > 0 && (
      <section class="bg-[#F5F5F5] pt-8 sm:pt-14" aria-label="Кейсы">
        <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12"><CaseMosaic /></div>
      </section>
    )}
    <div class="bg-[#F5F5F5]">
      <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-14">
        <div class={`grid gap-6 lg:gap-8 ${isForm ? 'xl:grid-cols-[minmax(0,1fr)_minmax(0,520px)] items-start' : toc.length > 2 ? 'xl:grid-cols-[minmax(0,1fr)_280px] items-start' : ''}`}>
          <div class="grid gap-5 sm:gap-6 min-w-0">
            <article class="prose-bb flow">
              <Content />
            </article>
            {!isForm && d.type !== 'legal' && <div class="sec sec-tight"><AuthorBox author={d.author} date={d.date_modified} /></div>}
            {d.faq?.length > 0 && <div class="sec"><Faq items={d.faq} /></div>}
            {d.related?.length > 0 && <div class="sec"><Related items={d.related} /></div>}
          </div>
          {isForm ? (
            <div id="form" class="xl:sticky xl:top-6 scroll-mt-6"><LeadForm kind={formKind} title={d.form_title || (formKind === 'audit' ? 'Заявка на экспресс-аудит' : formKind === 'brief' ? 'Бриф на проект' : 'Написать нам')} /></div>
          ) : toc.length > 2 && (
            <aside class="hidden xl:block sticky top-6">
              <div class="grid gap-4">
                <nav aria-label="Содержание страницы" class="bg-white rounded-[28px] p-6">
                  <p class="text-[12px] font-semibold uppercase tracking-[.06em] text-gray-600 mb-3">На этой странице</p>
                  <ol class="grid gap-2.5 text-[14px] toc-list">
                    {toc.map((h, i) => <li><a class="toc-link" href={`#${h.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>)}
                    {d.faq?.length > 0 && <li><a class="toc-link" href="#faq-title"><span>?</span>Частые вопросы</a></li>}
                  </ol>
                </nav>
                <div class="bg-gray-900 text-white rounded-[28px] p-6 grid gap-4">
                  <p class="text-[16px] font-medium leading-snug">Проверим ваш сайт или профиль Авито бесплатно</p>
                  <RollButton href="/audit-besplatno/" label="Получить аудит" size="sm" class="justify-self-start" />
                </div>
              </div>
            </aside>
          )}
        </div>
      </div>
    </div>
  </>)}

  {d.type !== 'legal' && !isForm && (
    <section class="bg-[#F5F5F5]">
      <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-12 py-16 sm:py-20 lg:py-28 grid lg:grid-cols-[1fr_auto] gap-8 items-end">
        <div>
          <Badge num="→" label="Следующий шаг" border="border-gray-300" />
          <h2 class="text-[clamp(1.75rem,5vw,3.4rem)] font-medium leading-[1.08] tracking-[-0.03em] max-w-[20ch]">Начнём с бесплатного аудита: покажем, где теряются заявки</h2>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
          <RollButton href="/audit-besplatno/" label="Получить аудит" />
          <RollButton href="/brif/" label="Заполнить бриф" variant="light" />
        </div>
      </div>
    </section>
  )}
</Base>
