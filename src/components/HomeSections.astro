---
// Секции 2 и 3 промта (о нас, кейсы) + каналы, основной текст главной, FAQ.
import Badge from './Badge.astro';
import RollButton from './RollButton.astro';
import Faq from './Faq.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site.mjs';
import { previewFor } from '../lib/previews.mjs';
import CaseCard from './CaseCard.astro';
interface Props { d: any }
const { d } = Astro.props;
const IMG_S = 'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260516_090123_74be96d4-9c1b-40cf-932a-96f4f4babed3.png&w=1280&q=85';
const IMG_L = 'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260516_090133_c157d30b-a99a-4477-bec1-a446149ec3f2.png&w=1280&q=85';
const cases = (await getCollection('pages')).filter((p) => p.data.type === 'case').map((p) => p.data);
const featured = ['C-148', 'C-250'].map((id) => cases.find((c) => c.case?.id === id)).filter(Boolean);
const rest = cases.filter((c) => !featured.includes(c)).slice(0, 6);
const channels = d.channels || [];
---
<section class="bg-white pt-16 sm:pt-20 lg:pt-32 pb-12 sm:pb-16 lg:pb-24 overflow-hidden">
  <div class="max-w-[1440px] mx-auto">
    <div class="px-5 sm:px-8 lg:px-12"><Badge num="1" label="Знакомьтесь: Биба и Боба" /></div>
    <h2 class="px-5 sm:px-8 lg:px-12 text-[clamp(1.5rem,4vw,3.2rem)] font-medium leading-[1.12] tracking-[-0.02em] text-gray-900 mb-10 sm:mb-14 lg:mb-20 max-w-[26ch]">{d.about_title || 'Два практика с 2018 года: поиск и сайты, Авито. Один подрядчик на три канала заявок.'}</h2>
    <div class="px-5 sm:px-8 lg:px-12 grid gap-8 lg:gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-end">
      <div class="grid gap-6 content-start">
        <p class="text-[16px] sm:text-[18px] lg:text-[20px] leading-[1.6] font-medium text-gray-900 max-w-[46ch]">{d.about_text || d.lede}</p>
        <RollButton href="/o-nas/" label="Подробнее о нас" class="justify-self-start" />
      </div>
      <div class="grid grid-cols-[minmax(0,4fr)_minmax(0,6fr)] gap-4 sm:gap-5 items-end">
        <img src={IMG_S} alt="Работа над проектом за ноутбуком" class="w-full aspect-[438/346] object-cover rounded-xl sm:rounded-2xl" loading="lazy" decoding="async" width="438" height="346" />
        <img src={IMG_L} alt="Планирование работ по проекту у доски" class="w-full aspect-[3/2] object-cover rounded-xl sm:rounded-2xl" loading="lazy" decoding="async" width="900" height="600" />
      </div>
    </div>
  </div>
</section>

{channels.length > 0 && (
  <section class="bg-white pb-16 sm:pb-20 lg:pb-28">
    <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-12">
      <Badge num="2" label="Три канала заявок" />
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 md:[&>*:last-child]:col-span-2 lg:[&>*:last-child]:col-span-1">
        {channels.map((c, i) => (
          <a href={withBase(c.url)} class="group bg-[#F5F5F5] hover:bg-[#ececec] rounded-2xl p-3 pb-6 sm:pb-8 flex flex-col gap-5 transition-colors duration-300">
            {previewFor(c.url) && <span class="block overflow-hidden rounded-xl"><img src={withBase(previewFor(c.url).file)} alt={previewFor(c.url).alt || c.name} class="w-full aspect-[16/10] object-cover transition-transform duration-700 group-hover:scale-[1.04]" loading="lazy" decoding="async" width="1200" height="800" /></span>}
            <span class="text-[13px] text-gray-600 px-3 sm:px-5">0{i + 1}</span>
            <span class="px-3 sm:px-5 text-[clamp(1.6rem,3vw,2.4rem)] font-medium tracking-[-0.03em] leading-none">{c.name}</span>
            <span class="px-3 sm:px-5 text-[15px] text-gray-700 leading-relaxed">{c.text}</span>
            {c.facts?.length > 0 && (
              <dl class="grid gap-0 mt-auto px-3 sm:px-5">
                {c.facts.map((f) => <div class="grid grid-cols-[minmax(0,110px)_minmax(0,1fr)] gap-3 py-2 border-t border-gray-300 text-[13px]"><dt class="font-semibold">{f.k}</dt><dd class="text-gray-700">{f.v}</dd></div>)}
              </dl>
            )}
            <span class="px-3 sm:px-5 text-[13px] font-medium inline-flex items-center gap-2">Подробнее <svg class="arrow-rot" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="bg-[#F5F5F5] pt-16 sm:pt-20 lg:pt-28 pb-16 sm:pb-20 lg:pb-28">
  <div class="max-w-[1440px] mx-auto cq">
    <div class="px-5 sm:px-8 lg:px-12"><Badge num="3" label="Кейсы с цифрами из кабинета Авито" border="border-gray-300" /></div>
    <h2 class="px-5 sm:px-8 lg:px-12 text-[clamp(1.75rem,7vw,4.2rem)] sm:text-[clamp(2.5rem,5vw,4.2rem)] font-medium leading-[1.08] tracking-[-0.03em] mb-10 sm:mb-14 lg:mb-16">Наши проекты</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 lg:gap-7 px-5 sm:px-8 lg:px-12">
      {featured.map((c, i) => (
        <a href={withBase(c.url)} class="block">
          <div class={`relative ${i === 0 ? 'aspect-[329/246] bg-[#1a1d2e]' : 'aspect-[329/246] bg-[#3a3a3a]'} rounded-2xl overflow-hidden group cursor-pointer p-6 sm:p-8 flex flex-col justify-between text-white isolate`}>
            {previewFor(c.url) && <img src={withBase(previewFor(c.url).file)} alt={previewFor(c.url).alt || c.case.niche} class="absolute inset-0 -z-10 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" width="1200" height="800" />}
            <span class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/45 to-black/20" aria-hidden="true"></span>
            <span class="text-[13px] opacity-90">{c.case.scope}</span>
            <div>
              <p class="text-[clamp(2.6rem,7vw,5.5rem)] font-medium tracking-[-0.04em] leading-none tabular-nums">{c.case.contacts}</p>
              <p class="mt-2 text-[15px] opacity-90">обращений за месяц · {c.case.contact_price} за обращение</p>
            </div>
            <span class={`absolute bottom-4 left-4 h-9 w-9 group-hover:w-[168px] rounded-full ${i === 0 ? 'bg-white text-gray-900' : 'bg-gray-900 text-white'} flex items-center overflow-hidden transition-all duration-300 ease-in-out`}>
              <span class="flex-none w-9 h-9 grid place-items-center"><svg class="-rotate-45 group-hover:rotate-0 transition-transform duration-300" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
              <span class="text-[13px] font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">Смотреть кейс</span>
            </span>
          </div>
          <p class="text-[13px] sm:text-[14px] text-gray-600 mt-4 leading-relaxed">{c.case.deltas || c.lede}</p>
          <p class="text-[14px] sm:text-[15px] font-semibold text-gray-900 mt-1">{c.case.niche}</p>
        </a>
      ))}
    </div>
    {rest.length > 0 && (
      <div class="case-grid px-5 sm:px-8 lg:px-12 mt-8" data-count={rest.length}>
        {rest.map((c) => <CaseCard c={c} white />)}
      </div>
    )}
    <div class="px-5 sm:px-8 lg:px-12 mt-10"><RollButton href="/kejsy/" label="Все кейсы" variant="dark" /></div>
  </div>
</section>

<section class="bg-[#F5F5F5] py-16 sm:py-20 lg:py-28 border-t border-gray-200">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <Badge num="4" label="Чем мы занимаемся" border="border-gray-300" />
    <div class="grid gap-5 sm:gap-6">
      <div class="prose-bb flow"><slot /></div>
      <div class="sec"><Faq items={d.faq || []} /></div>
    </div>
  </div>
</section>
