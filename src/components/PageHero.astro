---
// Первый экран внутренних страниц: тот же серый фон с шейдером, что на главной, высота по контенту.
import Nav from './Nav.astro';
import ShaderBg from './ShaderBg.jsx';
import RollButton from './RollButton.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { withBase } from '../lib/site.mjs';
interface Props { d: any; image?: any }
const { d, image } = Astro.props;
const cta = d.hero_cta || {};
---
<section class="relative hero-fallback overflow-x-clip">
  <div class="absolute inset-0 z-10 pointer-events-none" aria-hidden="true"><ShaderBg client:only="react" /></div>
  <div class="relative z-40"><Nav current={d.url} /></div>
  <div class="relative z-20 max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-12 pt-10 sm:pt-14 lg:pt-20 pb-14 sm:pb-16 lg:pb-20">
    <Breadcrumbs items={d.breadcrumbs || []} />
    <div class={`grid gap-10 ${image ? (image.portrait ? 'lg:grid-cols-[1fr_30%] items-end' : 'lg:grid-cols-[1fr_38%] items-end') : ''}`}>
      <div>
        <h1 class="text-[clamp(1.75rem,7vw,3.6rem)] sm:text-[clamp(2.2rem,4.6vw,3.6rem)] font-medium leading-[1.08] tracking-[-0.03em] text-gray-900 max-w-[22ch] text-balance">{d.h1}</h1>
        {d.lede && <p class="mt-5 sm:mt-7 text-[16px] sm:text-[18px] leading-[1.6] text-gray-700 max-w-[60ch]">{d.lede}</p>}
        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row gap-4 sm:gap-5 sm:items-center">
          {cta.primary && <RollButton href={cta.primary.href} label={cta.primary.label} />}
          {cta.secondary && <RollButton href={cta.secondary.href} label={cta.secondary.label} variant="light" />}
        </div>
      </div>
      {image && (
        <img src={withBase(image.file)} alt={image.alt} width={image.width} height={image.height} class={`w-full ${image.portrait ? 'aspect-square max-w-[380px] justify-self-end' : 'aspect-[3/2]'} object-cover rounded-2xl`} fetchpriority="high" decoding="async" />
      )}
    </div>
    {d.highlights?.length > 0 && (
      <dl class="mt-10 sm:mt-14 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {d.highlights.map((h) => (
          <div class="bg-white/80 backdrop-blur rounded-2xl p-4 sm:p-5">
            <dt class="sr-only">{h.label}</dt>
            <dd class="text-[clamp(1.4rem,3vw,2rem)] font-medium tracking-[-0.03em] leading-none text-gray-900 tabular-nums">{h.value}</dd>
            <dd class="mt-2 text-[13px] sm:text-[14px] text-gray-600 leading-snug">{h.label}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>
