---
import { withBase } from '../lib/site.mjs';
interface Props { items: { url: string; title: string; text?: string }[] }
const { items = [] } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby="rel-title">
    <h2 id="rel-title" class="text-[clamp(1.4rem,2.6vw,2rem)] font-medium tracking-[-0.02em] mb-6">Смотрите также</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((r) => (
        <a href={withBase(r.url)} class="group bg-[#F5F5F5] hover:bg-[#ececec] rounded-2xl p-5 sm:p-6 transition-colors duration-300 flex flex-col gap-2">
          <span class="text-[16px] font-semibold text-gray-900">{r.title}</span>
          {r.text && <span class="text-[14px] text-gray-600 leading-relaxed">{r.text}</span>}
          <span class="mt-auto pt-3 text-[13px] font-medium inline-flex items-center gap-2">Подробнее <svg class="arrow-rot" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </a>
      ))}
    </div>
  </section>
)}
