---
import { withBase } from '../lib/site.mjs';
interface Props { items: { name: string; url: string }[] }
const { items = [] } = Astro.props;
---
{items.length > 1 && (
  <nav aria-label="Хлебные крошки" class="text-[13px] text-gray-600 mb-5 sm:mb-8">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
      {items.map((b, i) => (
        <li class="flex items-center gap-2">
          {i < items.length - 1 ? <a class="hover:text-gray-900 transition-colors" href={withBase(b.url)}>{b.name}</a> : <span aria-current="page" class="text-gray-900">{b.name}</span>}
          {i < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))}
    </ol>
  </nav>
)}
